<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="JARVIS" android:textSize="34sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Offline" android:textSize="16sp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/chat" android:textSize="17sp" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
<Button android:id="@+id/listen" android:text="🎙 Listen" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/start" android:text="Start Assistant" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/stop" android:text="Stop Assistant" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
